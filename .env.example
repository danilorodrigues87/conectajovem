# Em dev: proxy Vite → XAMPP (sem CORS). Em produção use URL absoluta.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost

# Opcional: IP fixo na rede (se auto-detecção falhar). Ex.: 192.168.22.112
# VITE_DEV_LAN_IP=192.168.22.112

# Produção: use .env.production (Vite carrega automaticamente no build)
# VITE_API_BASE_URL=https://admin.ctieducacional.com.br/api/v1
