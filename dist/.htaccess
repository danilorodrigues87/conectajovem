# SPA fallback — HostGator / Apache (rotas React → index.html)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Artigos do blog com Open Graph estático (Facebook / WhatsApp)
  RewriteCond %{REQUEST_URI} ^/blog/([a-z0-9-]+)/?$
  RewriteCond %{DOCUMENT_ROOT}/blog/%1/index.html -f
  RewriteRule ^blog/([a-z0-9-]+)/?$ blog/$1/index.html [L]

  RewriteRule ^ index.html [L]
</IfModule>

Options -Indexes
DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType image/svg+xml .svg .svgz
</IfModule>
